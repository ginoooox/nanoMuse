// The resulting unsigned app is re-signed locally by the installer.
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
CODE_SIGN_IDENTITY =
DEVELOPMENT_TEAM =
CODE_SIGN_ENTITLEMENTS =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) NANOMUSE_PERSONAL
// Info.plist explicitly expands this custom key for packaging validation.
NANOMUSE_PERSONAL_BUILD = YES
